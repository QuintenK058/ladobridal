---
import { pickReviews, formatReviewDate, REVIEWS, type RegionTag, type ServiceTag } from '../data/reviews';
import Icon from './Icon.astro';
interface Props {
  variant?: 'carousel' | 'pair' | 'snippet';
  region?: RegionTag; service?: ServiceTag; featured?: 'heat' | 'italy';
  lang?: 'nl' | 'en';
  placeholderHints?: string[];
}
const { variant = 'pair', region, service, featured, lang = 'nl', placeholderHints } = Astro.props;
const nl = lang === 'nl';
const n = variant === 'carousel' ? 6 : variant === 'pair' ? 2 : 1;
let list = pickReviews({ region, service, featured }, n);
if (variant === 'carousel' && REVIEWS.length) {
  // Feature the 37°C review and the Italy weekend first, then the rest.
  const feat = REVIEWS.filter((r) => r.featured);
  list = [...feat, ...REVIEWS.filter((r) => !r.featured)].slice(0, 6);
}
const hints = placeholderHints ?? (variant === 'carousel'
  ? ['echte Google-review over de look die bij 37°C bleef zitten', 'echte Google-review over het trouwweekend in Italië', 'echte Google-review (Friesland)']
  : [`echte Google-review${region ? ` · regio ${region}` : ''}${service ? ` · dienst ${service}` : ''}`, 'tweede echte Google-review (fallback: algemeen)']);
const placeholders = list.length ? [] : hints.slice(0, n);
---
{variant === 'snippet' && (
  list.length ? (
    <p class="review-snippet">“{list[0].text.length > 140 ? list[0].text.slice(0, 137).trimEnd() + '…' : list[0].text}” — {list[0].name}</p>
  ) : (
    <p class="review-snippet"><span class="ph">[REVIEWFRAGMENT · bv. “Mijn make-up zat er na een hele dag bij 37°C nog perfect op.” — exacte tekst + naam uit Google]</span></p>
  )
)}

{variant === 'pair' && (
  <div class="grid">
    {list.map((r) => (
      <article class="review-card col-half reveal">
        <span class="stars" aria-label="5 sterren">{[1,2,3,4,5].map(() => <Icon name="star" size={13} />)}</span>
        <blockquote class="mt-1"><p>{r.text}</p></blockquote>
        <footer><strong>{r.name}</strong>{r.location && ` · ${r.location}`} · {formatReviewDate(r.date, lang)} · Google</footer>
      </article>
    ))}
    {placeholders.map((h) => (
      <article class="review-card col-half"><div class="ph-block">[REVIEW · {h}] {nl ? 'Hier komt alleen een echte review, nooit verzonnen tekst.' : 'Only a real review goes here, never invented text.'}</div></article>
    ))}
  </div>
)}

{variant === 'carousel' && (
  <div class="quote-carousel" data-carousel aria-roledescription="carousel" aria-label={nl ? 'Reviews van bruiden' : 'Reviews from brides'}>
    <div aria-live="polite">
      {list.map((r, i) => (
        <figure class:list={['quote-slide', i === 0 && 'is-active']} aria-roledescription="slide" aria-label={`${i + 1} / ${list.length}`}>
          <blockquote class="pull-quote"><p>{r.text}</p></blockquote>
          <figcaption class="quote-meta"><strong>{r.name}</strong>{r.location && ` · ${r.location}`} · {formatReviewDate(r.date, lang)}</figcaption>
        </figure>
      ))}
      {placeholders.map((h, i) => (
        <figure class:list={['quote-slide', i === 0 && 'is-active']} aria-roledescription="slide" aria-label={`${i + 1} / ${placeholders.length}`}>
          <blockquote class="pull-quote"><p><span class="ph">[REVIEW · {h}]</span></p></blockquote>
          <figcaption class="quote-meta"><strong>[Voornaam]</strong> · [locatie bruiloft] · [maand jaar]</figcaption>
        </figure>
      ))}
    </div>
    <div class="carousel-controls">
      <button type="button" data-prev aria-label={nl ? 'Vorige review' : 'Previous review'}><Icon name="arrow-left" /></button>
      <button type="button" data-next aria-label={nl ? 'Volgende review' : 'Next review'}><Icon name="arrow-right" /></button>
      <span class="count" data-count>1 / {list.length || placeholders.length}</span>
    </div>
  </div>
)}
