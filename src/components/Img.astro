---
/**
 * EditorialImage. Without `src` it renders a labelled placeholder (HARD RULE 2: no stock brides).
 * With `src` (a /public path without extension, e.g. "/img/bruidskapsel-los-opgestoken-friesland")
 * it expects `-800.avif/-800.webp/-1600.avif/-1600.webp` variants and renders a responsive <picture>.
 */
interface Props {
  ratio?: '4x5' | '3x4' | '3x2' | '16x9' | '1x1' | '2x3';
  shot: string;            // required shot description, used for placeholder + as alt fallback
  alt?: string;
  src?: string;
  arch?: boolean;
  dark?: boolean;
  priority?: boolean;
  reveal?: boolean;
  parallax?: number;
  kenBurns?: boolean;
  sizes?: string;
  class?: string;
  caption?: string;
  delay?: number;
}
const { ratio = '4x5', shot, alt, src, arch, dark, priority, reveal = true, parallax, kenBurns, sizes = '(min-width: 900px) 50vw, 100vw', caption, delay = 0 } = Astro.props;
const [w, h] = ratio.split('x').map(Number);
const cls = ['media', `ratio-${ratio}`, arch && 'media--arch', reveal && !priority && 'reveal-img', Astro.props.class].filter(Boolean).join(' ');
---
<figure class={caption ? 'figure' : undefined} style="margin:0">
  <div class={cls} style={delay ? `--d:${delay}s` : undefined} data-parallax={parallax} data-cursor-view={Astro.props.class?.includes('view') ? '' : undefined}>
    {src ? (
      <picture class={kenBurns ? 'ken-burns' : undefined}>
        <source type="image/avif" srcset={`${src}-800.avif 800w, ${src}-1600.avif 1600w`} sizes={sizes} />
        <source type="image/webp" srcset={`${src}-800.webp 800w, ${src}-1600.webp 1600w`} sizes={sizes} />
        <img src={`${src}-1600.webp`} alt={alt ?? ''} width={w * 320} height={h * 320} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" />
      </picture>
    ) : (
      <div class:list={['ph-img', dark && 'ph-img--dark', kenBurns && 'ken-burns']} role="img" aria-label={alt ?? `Fotoplaatsing: ${shot}`}>
        <span class="ph-img__label" aria-hidden="true">Foto · {shot}</span>
      </div>
    )}
  </div>
  {caption && <figcaption class="caption">{caption}</figcaption>}
</figure>
