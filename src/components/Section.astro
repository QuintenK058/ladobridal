---
/** Editorial text section: heading left (sticky on desktop), prose right. Optional image. */
interface Props { id?: string; eyebrow?: string; title: string; linen?: boolean; shot?: string; ratio?: '4x5' | '3x4' | '3x2' }
const { id, eyebrow, title, linen, shot, ratio = '3x2' } = Astro.props;
---
<section class:list={['section', linen && 'section--linen']} id={id}>
  <div class="container grid">
    <div class="col-quarter sticky-desk">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 class="mt-1" set:html={title} />
    </div>
    <div class="col-rest">
      <div class="prose reveal"><slot /></div>
      {shot && <div class="mt-3"><slot name="media" /></div>}
    </div>
  </div>
</section>
