---
interface Props { items: { name: string; href: string }[]; lang?: 'nl' | 'en' }
const { items, lang = 'nl' } = Astro.props;
---
<nav class="breadcrumbs" aria-label={lang === 'nl' ? 'Kruimelpad' : 'Breadcrumb'}>
  <ol>
    {items.map((it, i) => (
      <li>{i < items.length - 1 ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}</li>
    ))}
  </ol>
</nav>
