---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Algemene voorwaarden', href: '/algemene-voorwaarden' }];
---
<Base title="Algemene voorwaarden | Lado Bridal" description="De algemene voorwaarden van Lado Bridal voor bruidsstyling: boeking, aanbetaling, annulering en reiskosten." breadcrumbs={crumbs}>
  <PageHero crumbs={crumbs} eyebrow="Voorwaarden" h1="Algemene voorwaarden" cta={false} />
  <section class="section--tight" style="padding-top:0"><div class="container"><div class="prose">
    <p class="ph-block">[PLAATS HIER DE BESTAANDE ALGEMENE VOORWAARDEN VAN LADO BRIDAL — niet laten genereren. Bekende uitgangspunten: boeking definitief na handtekening + 25% aanbetaling; reiskosten €0,35/km heen en terug vanaf Leeuwarden; boven 75 km enkele reis verblijfkosten; destination: vluchten en verblijf apart.]</p>
  </div></div></section>
</Base>
