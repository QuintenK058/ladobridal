---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { SITE, ph } from '../data/site';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Contact', href: '/contact' }];
---
<Base title="Contact | By Lado hair extensions Leeuwarden" description="Contact met By Lado hair extensions in Leeuwarden: telefoon, e-mail, WhatsApp en Instagram. Of plan direct je consult." breadcrumbs={crumbs}>
  <PageHero crumbs={crumbs} eyebrow="Contact" h1="Contact" lead="Liever eerst even contact? Stuur een bericht, dan hoor je snel van me." />
  <section class="section--tight" style="padding-top:0"><div class="container grid">
    <ul class="col-half stack" role="list" style="--stack:1.1rem">
      <li class="cluster" style="--gap:.75rem"><Icon name="phone" /> {SITE.phone ? <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} data-track="phone_click">{SITE.phoneDisplay || SITE.phone}</a> : <Fragment set:html={ph('TELEFOON')} />}</li>
      <li class="cluster" style="--gap:.75rem"><Icon name="mail" /> {SITE.email ? <a href={`mailto:${SITE.email}`} data-track="email_click">{SITE.email}</a> : <Fragment set:html={ph('E-MAIL')} />}</li>
      <li class="cluster" style="--gap:.75rem"><Icon name="whatsapp" /> {SITE.whatsapp ? <a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener" data-track="whatsapp_click">WhatsApp</a> : <Fragment set:html={ph('WHATSAPP')} />}</li>
      <li class="cluster" style="--gap:.75rem"><Icon name="instagram" /> {SITE.instagram ? <a href={SITE.instagram} target="_blank" rel="noopener">{SITE.instagramHandle}</a> : <Fragment set:html={ph('INSTAGRAM')} />}</li>
    </ul>
    <div class="col-half small muted">
      <p><strong style="color:var(--ink)">Studio</strong>: {SITE.streetAddress ? `${SITE.streetAddress}, ${SITE.postalCode} Leeuwarden` : 'Leeuwarden, op afspraak'}</p>
      <p class="mt-1"><strong style="color:var(--ink)">Openingstijden</strong>: <Fragment set:html={SITE.openingHours || ph('OPENINGSTIJDEN')} /></p>
      <p class="mt-1"><strong style="color:var(--ink)">Parkeren &amp; route</strong>: <Fragment set:html={ph('CHECK')} /></p>
    </div>
  </div></section>
</Base>
