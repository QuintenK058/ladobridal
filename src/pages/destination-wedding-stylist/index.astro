---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Timeline from '../../components/Timeline.astro';
import Img from '../../components/Img.astro';
import Reviews from '../../components/Reviews.astro';
import Faq from '../../components/Faq.astro';
import Related from '../../components/Related.astro';
import Cta from '../../components/Cta.astro';
import { PRICES, euro } from '../../data/site';
import { faqSchema, serviceSchema } from '../../data/schema';
const path = '/destination-wedding-stylist';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Destination weddings', href: path }];
const price = PRICES.completeBruidslook ? euro(PRICES.completeBruidslook) : '[PRIJS]';
const countries = [
  { c: 'Italië', t: 'Villa’s en wijngoederen in Toscane en Umbrië. Warme dagen, gouden licht en lange diners buiten.', href: '/destination-wedding-stylist/italie' },
  { c: 'Spanje', t: 'Finca’s in het binnenland en locaties aan de kust. Hitte en zon vragen om echt langhoudend werk.' },
  { c: 'Frankrijk', t: 'Châteaux en landhuizen, van de Provence tot de Loire. Klassiek, romantisch en vaak meerdaags.' },
  { c: 'Portugal', t: 'Quinta’s, kliffen en de Atlantische kust: zon, maar ook wind van zee.' },
  { c: 'Oostenrijk', t: 'Elopements in de bergen. Koelere lucht, fel licht op hoogte en soms een wandeling naar de ceremonieplek.' },
  { c: 'Griekenland', t: 'Wit, blauw en zee. Fel licht en warme wind: een kapsel met steun is hier geen luxe.' },
  { c: 'België & Duitsland', t: 'Dichtbij, maar net over de grens. Vaak zonder vlucht bereikbaar.' },
];
const faq = [
  { q: 'Wat kost een bruidsstylist voor een bruiloft in het buitenland?', a: `<p>De styling volgt de Complete Bruidslook, vanaf ${price}. Daarnaast reken ik reistijd, vluchten en verblijf; die staan als aparte posten in je offerte op maat, zodat je precies ziet waar het geld naartoe gaat.</p>` },
  { q: 'Hoe gaat de proefsessie als ik in het buitenland trouw?', a: '<p>In mijn studio in Leeuwarden, ruim voor je vertrek. Woon je zelf in het buitenland, dan kan de voorbereiding digitaal (videogesprek, foto’s van je haar en huid) en plannen we de proefsessie wanneer je in Nederland bent, of op locatie in de dagen voor de bruiloft.</p>' },
  { q: 'Kan ik je voor meerdere dagen boeken?', a: '<p>Ja, meerdaagse boekingen zijn welkom: een welkomstdiner, de trouwdag en een brunch of shoot de dag erna. We stellen samen een planning per dag op.</p>' },
  { q: 'Blijft mijn look zitten bij hitte?', a: '<p>Ja, daar bouw ik de look op: een goed voorbereide huid, een dunne basis die ik vastzet, waterproof producten rond de ogen, en een kapsel met steun dat niet uitzakt in warme of vochtige lucht. Een touch-up uur is bij een lange, warme dag een slimme keuze.</p>' },
  { q: 'Hoe ver vooraf moet ik boeken?', a: '<p>Voor een zomerbruiloft liefst 9–12 maanden vooraf. Voor een destination wedding is het extra fijn om vroeg te boeken, omdat vluchten en verblijf dan nog goed te regelen zijn.</p>' },
  { q: 'Welke landen doe je?', a: '<p>Onder meer Italië, Spanje, Frankrijk, Portugal, Oostenrijk, Griekenland, België en Duitsland. Een ander land? Neem contact op.</p>' },
];
---
<Base title="Destination wedding stylist | Bruidsstyling in het buitenland"
  description={`Bruidsstyliste voor je bruiloft in het buitenland: Italië, Spanje, Frankrijk en meer. Complete Bruidslook vanaf ${price} + reis en verblijf op maat.`}
  ogTitle="Bruidsstylist voor je bruiloft in het buitenland · Lado Bridal" ogDescription="Ik reis met je mee: haar en make-up voor destination weddings, met proefsessie vooraf in Nederland."
  breadcrumbs={crumbs} schema={[serviceSchema({ name: 'Destination wedding styling', path, description: 'Bruidskapsel en bruidsmake-up voor bruiloften in het buitenland.', area: ['Italië', 'Spanje', 'Frankrijk', 'Portugal', 'Oostenrijk', 'Griekenland', 'België', 'Duitsland'].map((n) => ({ type: 'Country' as const, name: n })) }), faqSchema(faq)]}>
  <PageHero crumbs={crumbs} eyebrow="Destination weddings" h1="Bruidsstylist voor je bruiloft in het buitenland"
    lead="Trouwen in Italië, Spanje of Frankrijk, en toch een stylist die je kent en vertrouwt? Ik reis met je mee. We doen de proefsessie vooraf in Nederland, en op je trouwdag sta ik naast je, waar ter wereld dat ook is."
    shot="bruid in het buitenland, warm licht · 4:5" badge>
    <p class="price-from mt-2">Complete Bruidslook vanaf {price} <span class="small muted" style="font-family:var(--sans)">+ reis- en verblijfkosten op maat</span></p>
  </PageHero>

  <Section eyebrow="Waarom" title="Waarom je eigen <em>bruidsstyliste</em> meenemen naar het buitenland?">
    <p>Een stylist ter plekke vinden is lastig als je de taal niet spreekt, geen proefsessie kunt doen en alleen op foto’s moet vertrouwen. Je weet pas op de dag zelf hoe het eruitziet. Dat is precies de onzekerheid die je niet wilt.</p>
    <p>Met een bruidsstyliste uit Nederland doe je de proefsessie vooraf, rustig, in je eigen taal. Je weet hoe je look eruitziet, hoe lang het duurt en wat je kunt verwachten. Op de dag zelf heb je iemand naast je die je al kent, en dat geeft rust in een omgeving waar alles nieuw is.</p>
    <p>Ik heb {`5+`} internationale bruiloften gedaan, waaronder een trouwweekend in Italië. Ik weet wat reizen met een kit betekent, hoe je plant rond een vlucht, en hoe je een look bouwt die in de zuidelijke hitte de hele dag blijft zitten.</p>
  </Section>

  <section class="section section--linen">
    <div class="container">
      <div class="section-head"><p class="eyebrow">Hoe het werkt</p><h2>Van offerte <em>tot vertrek</em></h2></div>
      <Timeline horizontal steps={[
        { title: 'Intake', text: 'We bespreken je land, locatie, aantal dagen en personen.' },
        { title: 'Offerte op maat', text: 'Styling, reistijd, vluchten en verblijf, elk als aparte post. Binnen 2 werkdagen.' },
        { title: 'Proefsessie', text: 'In de studio in Leeuwarden, of digitaal voorbereid als je in het buitenland woont.' },
        { title: 'Reizen', text: 'Ik reis vooraf, zodat ik ruim op tijd en uitgerust ben.' },
        { title: 'Jouw dag(en)', text: 'Styling per dag volgens de planning, met touch-ups waar nodig.' },
      ]} />
    </div>
  </section>

  <Section eyebrow="Klimaat" title="Hitte, wind en zon: <em>langhoudend</em> werken">
    <p>Een bruiloft in Zuid-Europa betekent vaak temperaturen waar je in Nederland niet op rekent. Make-up die hier een dag meegaat, kan daar na een uur glimmen of uitlopen. Ik bouw de look daarom anders op:</p>
    <ul>
      <li><strong>Huid:</strong> lichte hydratatie en een primer die olie in toom houdt, een dunne basis, en alles goed vastgezet.</li>
      <li><strong>Ogen:</strong> waterproof mascara en eyeliner, en een oogschaduwbasis die niet in de plooien kruipt.</li>
      <li><strong>Haar:</strong> een kapsel met steun. Krullen bouw ik op met meer houvast, want warme, vochtige lucht laat ze sneller uitzakken.</li>
      <li><strong>Touch-ups:</strong> bij een lange, warme dag raad ik een extra uur aan (€65), bijvoorbeeld voor het diner bij zonsondergang.</li>
    </ul>
  </Section>

  <section class="section section--linen">
    <div class="container">
      <div class="section-head"><p class="eyebrow">Landen</p><h2>Trouwen in Italië, Spanje, Frankrijk <em>en verder</em></h2></div>
      <div class="look-grid look-grid--3">
        {countries.map((c, i) => (
          <article class="card">
            <Img ratio={i % 2 ? '3x4' : '4x5'} shot={`bruiloft in ${c.c}`} delay={(i % 3) * 0.08} />
            <h3 class="card__title">{c.c}</h3>
            <p>{c.t}</p>
            {c.href && <a class="text-link" href={c.href}>Bruidsstylist voor je bruiloft in Italië <span class="arrow" aria-hidden="true">→</span></a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid align-center">
      <div class="col-media--left"><Img ratio="4x5" shot="trouwweekend Italië · uitgelichte bruid (met toestemming)" /></div>
      <div class="col-text--right">
        <p class="eyebrow">Uitgelicht</p>
        <h2 class="mt-1">Een trouwweekend <em>in Italië</em></h2>
        <p class="mt-2 ph-block">[CASE · korte beschrijving van het Italië-weekend door Quinty: regio, aantal dagen, looks per dag, wat de uitdaging was]</p>
        <div class="mt-3"><Reviews variant="snippet" featured="italy" /></div>
        <a class="text-link mt-2" href="/destination-wedding-stylist/italie">Bruidsstyling voor je bruiloft in Italië <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section section--linen">
    <div class="container"><Reviews variant="pair" region="destination" /></div>
  </section>

  <section class="section">
    <div class="container grid">
      <div class="col-quarter"><p class="eyebrow">FAQ</p><h2 class="mt-1">Trouwen in het buitenland: <em>visagie en haar</em></h2></div>
      <div class="col-rest"><Faq items={faq} /></div>
    </div>
  </section>

  <Related links={[
    { href: '/destination-wedding-stylist/italie', label: 'Bruidsstylist voor je bruiloft in Italië' },
    { href: '/complete-bruidslook', label: 'Complete Bruidslook' },
    { href: '/proefsessie', label: 'Zo gaat de proefsessie' },
    { href: '/tarieven', label: 'Tarieven' },
  ]} />
  <Cta title="Trouwen in het buitenland? <em>Check je datum.</em>" />
</Base>
