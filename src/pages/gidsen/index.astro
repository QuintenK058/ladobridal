---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Cta from '../../components/Cta.astro';
import { GUIDES } from '../../data/site';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Gidsen', href: '/gidsen' }];
const ready = GUIDES.filter((g) => g.ready);
---
<Base title="Gidsen voor bruiden: haar, make-up & planning | Lado Bridal"
  description="Praktische gidsen voor bruiden: wat een bruidsstyliste kost, hoe je je trouwochtend plant, los of opgestoken haar en make-up die de hele dag blijft zitten."
  breadcrumbs={crumbs}>
  <PageHero crumbs={crumbs} eyebrow="Gidsen" h1="Gidsen voor bruiden" cta={false}
    lead="Praktische antwoorden op de vragen die bruiden me het vaakst stellen, over prijzen, planning, haar en make-up." />
  <section class="section--tight" style="padding-top:0">
    <div class="container">
      <ul class="region-list" role="list">
        {ready.map((g) => <li><a href={g.slug}>{g.title}<small>Gids</small></a></li>)}
      </ul>
      <p class="small muted mt-3">Binnenkort: {GUIDES.filter((g) => !g.ready).map((g) => g.title).join(' · ')}.</p>
    </div>
  </section>
  <Cta />
</Base>
