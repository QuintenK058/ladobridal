---
import { PHOTO } from '../data/photos';
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import RatingBadge from '../components/RatingBadge.astro';
import Timeline from '../components/Timeline.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { SITE, PRICES, INCLUDED_NL, DESTINATIONS_NL, REGIONS, LOCATIONS, euro } from '../data/site';
import { faqSchema } from '../data/schema';

const faq = [
  { q: 'Is de proefsessie inbegrepen?', a: '<p>Ja. Bij de Complete Bruidslook hoort altijd een volledige proefsessie in mijn studio in Leeuwarden, 4–8 weken voor de bruiloft. We stemmen dan haar en make-up af op je jurk, je huid en de planning van de dag. <a href="/proefsessie">Zo gaat de proefsessie</a>.</p>' },
  { q: 'Kom je op locatie?', a: '<p>Ja, op je trouwdag kom ik naar je toe: thuis, in een hotel of op de trouwlocatie zelf. Je hoeft die ochtend nergens heen.</p>' },
  { q: 'In welke regio’s werk je?', a: '<p>Vanuit Leeuwarden werk ik in heel Noord-Nederland: Friesland, Groningen, Drenthe en Overijssel, en ook in Noord-Holland en de rest van het land. Bekijk <a href="/bruidsstylist-nederland">alle regio’s</a>.</p>' },
  { q: 'Reis je mee naar het buitenland?', a: '<p>Graag. Ik heb bruiden gestyled in onder meer Italië, en reis naar Spanje, Frankrijk, Portugal, Oostenrijk, Griekenland, België en Duitsland. Meerdaagse boekingen zijn welkom. Lees meer over <a href="/destination-wedding-stylist">bruidsstyling in het buitenland</a>.</p>' },
  { q: 'Hoe ver van tevoren moet ik boeken?', a: '<p>Voor het hoogseizoen (mei–september) raken data vaak 9–12 maanden vooruit vol. Voor rustigere periodes is een paar maanden vooraf meestal genoeg. Je boeking staat vast na ondertekening en een aanbetaling van 25%.</p>' },
  { q: 'Wat kost een bruidsstyliste?', a: `<p>De Complete Bruidslook (haar en make-up, inclusief proefsessie en styling guide) begint vanaf ${PRICES.completeBruidslook ? euro(PRICES.completeBruidslook) : '[PRIJS]'}. Reiskosten zijn €0,35 per km vanaf Leeuwarden, heen en terug. Bekijk de <a href="/tarieven">tarieven en de prijscalculator</a> of lees <a href="/wat-kost-een-bruidsstyliste-friesland">wat een bruidsstyliste in Friesland kost</a>.</p>` },
];

const portfolio = [
  { p: PHOTO.hogeKnot, cap: 'Hoge knot met volume' },
  { p: PHOTO.omhelzing, cap: 'Romantische opsteek met parels' },
  { p: PHOTO.blondeKrullen, cap: 'Half-los met volle krullen' },
  { p: PHOTO.kapel, cap: 'In het licht van de kapel' },
  { p: PHOTO.golven, cap: 'Hollywood-golven op donker haar' },
  { p: PHOTO.gevlochten, cap: 'Gevlochten opsteek met bloemen' },
  { p: PHOTO.lageStaart, cap: 'Strakke lage staart' },
];
---
<Base
  title="Bruidsstylist Friesland | Bruidskapsel & make-up op locatie | Lado Bridal"
  description="Bruidskapsel en bruidsmake-up door Quinty Kant, MUAH-gecertificeerd. Proefsessie in Leeuwarden, styling op locatie in Noord-Nederland en het buitenland. Check je datum."
  ogTitle="Lado Bridal · Bruidskapsel & make-up op locatie"
  ogDescription="MUAH-gecertificeerd bruidsstylist Quinty Kant: proefsessie in Leeuwarden, op je trouwdag naar je toe. In Noord-Nederland en het buitenland."
  schema={[faqSchema(faq)]}
  overDark
  preloader
>
  <!-- 2. HERO -->
  <section class="hero" data-hero>
    <div class="hero__media">
      <Img ratio="4x5" shot="hero" src={PHOTO.toost.src} alt={PHOTO.toost.alt} priority kenBurns reveal={false} sizes="(min-width: 900px) 44vw, 100vw" />
    </div>
    <div class="container hero__content">
      <p class="display hero-words" data-split>Jouw <em>droomlook,</em> tot in de perfectie gestyled.</p>
      <h1>Bruidskapsel &amp; make-up voor bruiden in Friesland en daarbuiten</h1>
      <div class="hero__actions">
        <button type="button" class="btn btn--light" data-open-form data-track-label="hero">Check je datum <span class="arrow" aria-hidden="true">→</span></button>
        <a class="btn btn--ghost-light" href="/portfolio">Bekijk portfolio</a>
      </div>
      <div class="cluster mt-3" style="--gap:1.25rem">
        <RatingBadge />
        <p class="hero__meta" style="margin:0">MUAH-gecertificeerd · 40+ bruiden · Proefsessie inbegrepen</p>
      </div>
    </div>
    <span class="scroll-cue" aria-hidden="true"></span>
  </section>

  <!-- 3. MARQUEE -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[0, 1].map(() => ['Bruidskapsel', 'Bruidsvisagie', 'Complete Bruidslook', 'Destination weddings', 'Gala & gasten'].map((w) => <span>{w} ·</span>))}
    </div>
  </div>

  <!-- 4. INTRO -->
  <section class="section">
    <div class="container grid align-center">
      <div class="col-media--left intro-media">
        <Img ratio="4x5" arch shot="portret Quinty" src={PHOTO.quinty.src} alt={PHOTO.quinty.alt} />
        <div class="intro-media__detail" data-parallax="0.08">
          <Img ratio="3x4" shot="detail" src={PHOTO.wenkbrauwen.src} alt={PHOTO.wenkbrauwen.alt} delay={0.2} sizes="25vw" />
        </div>
      </div>
      <div class="col-text--right">
        <p class="eyebrow">Over mij</p>
        <h2 class="mt-2 reveal-text" data-split>Hi, ik ben <em>Quinty.</em></h2>
        <div class="stack mt-2 reveal" style="--stack:1rem">
          <p>Ik ben bruidsstylist en make-up artist uit Leeuwarden, gecertificeerd door MUAH. Al vier jaar style ik bruiden op de ochtend van hun bruiloft, van een stadhuis in Friesland tot een trouwweekend in Italië.</p>
          <p>Ik werk rustig en precies. Op de trouwochtend ben ik er op tijd, met een planning waarin ruimte zit, zodat jij niet op de klok hoeft te kijken. Mijn stijl is natuurlijk: je ziet er op je mooist uit, maar nog steeds als jezelf.</p>
          <p>Bruiden kiezen voor mij omdat ze haar en make-up in één hand willen, omdat de proefsessie altijd is inbegrepen, en omdat de look de hele dag blijft zitten, ook bij hitte en tijdens het dansen.</p>
        </div>
        <svg class="signature" viewBox="0 0 220 70" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-label="Quinty" role="img">
          <path d="M14 46c10-24 34-34 40-20 5 12-10 26-22 26-10 0 2-14 14-8 8 4 16 14 26 8M70 30c-3 9-4 17 2 18s10-10 12-17c-2 9-2 17 4 16 4-1 6-6 8-11M100 33c-1 6-2 11 0 13M101 24v1M110 46c2-6 4-12 9-13 4-1 4 4 3 13M130 22c-3 12-4 22 0 24M124 31h12M146 31c-2 7-3 13 2 14 5 1 8-7 9-14-1 12-4 24-12 26-6 2-8-4 0-8 8-4 22-8 34-18"/>
        </svg>
        <a class="text-link mt-2" href="/over-mij">Meer over mij <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 5. PROOF -->
  <section class="section--tight" aria-label="In cijfers">
    <div class="container">
      <dl class="stats">
        <div><dt class="sr-only">Jaar ervaring</dt><dd class="stat__num" data-count={SITE.stats.years}>{SITE.stats.years}</dd><dd class="stat__label">jaar ervaring</dd></div>
        <div><dt class="sr-only">Bruiden gestyled</dt><dd class="stat__num" data-count={SITE.stats.brides} data-suffix="+">{SITE.stats.brides}+</dd><dd class="stat__label">bruiden gestyled</dd></div>
        <div><dt class="sr-only">Internationale bruiloften</dt><dd class="stat__num" data-count={SITE.stats.international} data-suffix="+">{SITE.stats.international}+</dd><dd class="stat__label">internationale bruiloften</dd></div>
        <div><dt class="sr-only">Google-beoordeling</dt><dd class="stat__num" data-count={SITE.rating.value} data-decimals="1" data-sep=",">5,0</dd><dd class="stat__label">op Google</dd></div>
      </dl>
    </div>
  </section>

  <!-- 6. DIENSTEN -->
  <section class="section" id="diensten">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Diensten</p>
        <h2 class="reveal-text" data-split>Voor élk <em>bijzonder</em> moment</h2>
      </div>
      <article class="service-block">
        <div class="service-block__media"><Img ratio="4x5" shot="bruidskapsel" src={PHOTO.lageKnot.src} alt={PHOTO.lageKnot.alt} /></div>
        <div class="service-block__text reveal">
          <span class="service-block__num">01 — Bruidskapsel</span>
          <h3>Bruidskapsel</h3>
          <p>Los, half-los of opgestoken, met of zonder sluier. Gestyled om wind, warmte en een dansvloer te doorstaan.</p>
          <a class="text-link" href="/bruidskapsel">Over het bruidskapsel <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </article>
      <article class="service-block service-block--flip">
        <div class="service-block__media"><Img ratio="3x4" shot="bruidsmake-up" src={PHOTO.sluier.src} alt={PHOTO.sluier.alt} /></div>
        <div class="service-block__text reveal">
          <span class="service-block__num">02 — Bruidsvisagie</span>
          <h3>Bruidsvisagie</h3>
          <p>Make-up die op je huid lijkt en er op de foto’s net zo goed uitziet als in het echt. Langhoudend, met wimpers inbegrepen.</p>
          <a class="text-link" href="/bruidsvisagie">Over bruidsvisagie <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </article>
      <article class="service-block">
        <div class="service-block__media"><Img ratio="4x5" shot="complete look" src={PHOTO.tafel.src} alt={PHOTO.tafel.alt} /></div>
        <div class="service-block__text reveal">
          <span class="service-block__num">03 — Complete Bruidslook</span>
          <span class="badge mt-1">Meest gekozen</span>
          <h3>Complete Bruidslook</h3>
          <p>Haar en make-up in één hand: één visie, één planning en een rustige ochtend. Inclusief proefsessie en persoonlijke styling guide.</p>
          <p class="price-from">vanaf {PRICES.completeBruidslook ? euro(PRICES.completeBruidslook) : <span class="ph">[PRIJS INCL. BTW]</span>}</p>
          <a class="text-link" href="/complete-bruidslook">Over de Complete Bruidslook <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </article>
      <article class="service-block service-block--flip">
        <div class="service-block__media"><Img ratio="3x4" shot="gasten" src={PHOTO.halfLos.src} alt={PHOTO.halfLos.alt} /></div>
        <div class="service-block__text reveal">
          <span class="service-block__num">04 — Gala &amp; gasten</span>
          <h3>Gala &amp; gasten</h3>
          <p>Voor bruidsmeisjes, moeders en gasten op de trouwdag, en voor gala’s, feesten en fotoshoots.</p>
          <a class="text-link" href="/gala-en-gasten-styling">Over gala- en gastenstyling <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </article>
    </div>
  </section>

  <!-- 7. PORTFOLIO (pinned horizontal on desktop) -->
  <section class="section--linen h-gallery" data-hgallery aria-labelledby="pf-title">
    <div class="h-gallery__sticky" style="padding-block: var(--section)">
      <div class="container"><div class="section-head" style="margin-bottom:2.5rem">
        <p class="eyebrow">Portfolio</p>
        <h2 id="pf-title">Een glimp van <em>mijn werk</em></h2>
      </div></div>
      <div class="h-gallery__track" tabindex="0" aria-label="Portfoliogalerij, scroll horizontaal">
        {portfolio.map((p) => (
          <figure class="h-gallery__item" style="margin:0">
            <Img ratio="4x5" shot={p.cap} src={p.p.src} alt={p.p.alt} reveal={false} sizes="(min-width: 900px) 30vw, 78vw" />
            <figcaption class="caption">{p.cap}</figcaption>
          </figure>
        ))}
      </div>
      <div class="container mt-3"><a class="btn btn--outline" href="/portfolio">Bekijk het volledige portfolio</a></div>
    </div>
  </section>

  <!-- 8. BEFORE / AFTER -->
  <section class="section">
    <div class="container grid align-center">
      <div class="col-media--left">
        <div class="ba" data-ba>
          <div class="ba__layer"><div class="ph-img ph-img--dark" role="img" aria-label="Voor: zonder make-up"><span class="ph-img__label">Foto · vóór, zonder make-up · alleen met toestemming</span></div></div>
          <div class="ba__layer ba__after"><div class="ph-img" role="img" aria-label="Na: natuurlijke bruidsmake-up"><span class="ph-img__label">Foto · ná, bruidsmake-up · zelfde licht en hoek</span></div></div>
          <span class="ba__tag" style="left:1rem">Voor</span><span class="ba__tag" style="right:1rem">Na</span>
          <input type="range" min="0" max="100" value="50" aria-label="Schuif om voor en na te vergelijken" />
          <span class="ba__handle" aria-hidden="true"></span>
        </div>
      </div>
      <div class="col-text--right reveal">
        <p class="eyebrow">Voor &amp; na</p>
        <h2 class="mt-2">Jij, maar dan <em>stralend</em></h2>
        <p class="mt-2">Bij deze look draait alles om huid die er echt uitziet: een dunne, langhoudende basis, zachte contouren en een ingetogen oog met wimpers die op de foto’s nét genoeg zijn. <span class="ph">[BESCHRIJVING VAN DEZE SPECIFIEKE LOOK + toestemming bruid]</span></p>
      </div>
    </div>
  </section>

  <!-- 9. WERKWIJZE -->
  <section class="section section--linen">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Werkwijze</p>
        <h2 class="reveal-text" data-split>Zo werken we <em>samen</em></h2>
      </div>
      <Timeline horizontal steps={[
        { title: 'Kennismaking', text: 'Een telefonische intake: je datum, je locatie, je jurk en hoe je je die dag wilt voelen.' },
        { title: 'Offerte binnen 2 werkdagen', text: 'Een persoonlijke offerte met alle kosten vooraf. Je boeking staat vast na ondertekening en 25% aanbetaling.' },
        { title: 'Proefsessie in Leeuwarden', text: '4–8 weken voor de bruiloft in mijn studio. We stemmen haar en make-up af tot het precies klopt.' },
        { title: 'Jouw trouwdag', text: 'Ik kom naar je toe, thuis, in een hotel of op de locatie, met een ruime planning.' },
        { title: 'Stralen tot de laatste dans', text: 'Je krijgt een styling guide voor de dag mee, en optioneel blijf ik voor touch-ups.' },
      ]} />
      <div class="grid mt-4">
        <div class="col-quarter"><h3>Wat altijd inbegrepen is</h3></div>
        <ul class="checklist checklist--2 col-rest" role="list">
          {INCLUDED_NL.map((i) => <li>{i}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- 10. REVIEWS -->
  <section class="section">
    <div class="container grid">
      <div class="col-quarter">
        <p class="eyebrow">Ervaringen</p>
        <h2 class="mt-2">Wat bruiden <em>zeggen</em></h2>
        <div class="mt-3"><RatingBadge /></div>
      </div>
      <div class="col-rest">
        <Reviews variant="carousel" />
        <div class="cluster mt-3">
          <a class="text-link" href="/ervaringen">Lees alle ervaringen <span class="arrow" aria-hidden="true">→</span></a>
          <a class="text-link" href={SITE.googleProfileUrl} target="_blank" rel="noopener" data-track="review_google_click">Bekijk op Google <span class="arrow" aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 11. DESTINATION -->
  <section class="section section--dark on-dark" style="overflow:hidden">
    <div style="position:absolute;inset:-10% 0;opacity:.35" data-parallax="0.15" aria-hidden="true"><div class="ph-img ph-img--dark" style="height:100%"><span class="ph-img__label">Foto · full-bleed · bruiloft in het buitenland, landschap</span></div></div>
    <div class="container" style="position:relative">
      <p class="eyebrow">Destination weddings</p>
      <h2 class="display mt-2 reveal-text" data-split style="max-width:14ch">Trouwen in het buitenland? Ik reis <em>met je mee.</em></h2>
      <p class="eyebrow eyebrow--plain mt-3 reveal" style="color:#E2D8CC;letter-spacing:.3em">{DESTINATIONS_NL.join(' · ')}</p>
      <a class="btn btn--light mt-3" href="/destination-wedding-stylist">Bruidsstyling in het buitenland <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- 12. REGIO'S -->
  <section class="section">
    <div class="container grid">
      <div class="col-main">
        <p class="eyebrow">Werkgebied</p>
        <h2 class="mt-2 reveal-text" data-split>Waar ik voor je kom <em>stylen</em></h2>
        <ul class="region-list mt-3" role="list">
          {REGIONS.map((r) => <li><a href={r.slug} data-preview={`bruiloft in ${r.name}`}>{r.label}<small>{r.note}</small></a></li>)}
        </ul>
      </div>
      <div class="col-aside">
        <h3 class="mt-4">Per trouwlocatie</h3>
        <ul class="stack mt-2" role="list" style="--stack:.9rem">
          {LOCATIONS.slice(0, 3).map((l) => <li><a class="link" href={l.slug}>{l.anchor}</a></li>)}
          <li><a class="text-link" href="/trouwlocaties">Alle trouwlocaties <span class="arrow" aria-hidden="true">→</span></a></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 13. FAQ -->
  <section class="section section--linen">
    <div class="container grid">
      <div class="col-quarter"><p class="eyebrow">FAQ</p><h2 class="mt-2">Goed om te <em>weten</em></h2></div>
      <div class="col-rest"><Faq items={faq} id="home-faq" /></div>
    </div>
  </section>

  <!-- 14. FINAL CTA -->
  <Cta />
</Base>
