---
import { PHOTO } from '../data/photos';
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Timeline from '../components/Timeline.astro';
import { SITE } from '../data/site';
---
<Base title="Bedankt voor je aanvraag | Lado Bridal" description="Je aanvraag is ontvangen. Je ontvangt binnen 2 werkdagen een persoonlijke offerte." noindex>
  <section class="page-hero">
    <div class="container grid align-center">
      <div class="col-main">
        <p class="eyebrow">Aanvraag ontvangen</p>
        <h1 class="mt-1">Dank je wel<span data-thanks-name></span>.</h1>
        <p class="lead">Wat fijn dat je aan mij denkt voor je trouwdag. Ik bekijk je aanvraag persoonlijk, en je ontvangt binnen 2 werkdagen een persoonlijke offerte. Liefs, Quinty</p>
      </div>
      <div class="col-aside"><Img ratio="4x5" arch shot="Quinty" src={PHOTO.quinty.src} alt={PHOTO.quinty.alt} priority /></div>
    </div>
  </section>
  <section class="section section--linen">
    <div class="container">
      <div class="section-head"><h2>Wat er nu <em>gebeurt</em></h2></div>
      <Timeline horizontal steps={[
        { title: 'Ik bekijk je aanvraag', text: 'Ik check je datum en je locatie in mijn agenda.' },
        { title: 'Korte intake', text: 'Vaak bel ik even om je wensen te bespreken.' },
        { title: 'Offerte binnen 2 werkdagen', text: 'Met alle kosten vooraf. Je datum staat vast na ondertekening en 25% aanbetaling.' },
      ]} />
    </div>
  </section>
  <section class="section">
    <div class="container cluster">
      <a class="btn" href="/portfolio">Bekijk het portfolio</a>
      <a class="btn btn--outline" href={SITE.instagram} target="_blank" rel="noopener">Instagram {SITE.instagramHandle}</a>
      <a class="btn btn--outline" href="/proefsessie">Zo gaat de proefsessie</a>
    </div>
  </section>
</Base>
