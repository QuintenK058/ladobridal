---
import { PHOTO } from '../data/photos';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import { SITE } from '../data/site';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Portfolio', href: '/portfolio' }];
/** Replace shot placeholders with real photos: set `src` (see Img.astro) + a descriptive Dutch alt text. */
const items = [
  { cat: 'kapsel', ratio: '4x5', p: PHOTO.hogeKnot, caption: 'Hoge knot met volume' },
  { cat: 'complete', ratio: '3x4', p: PHOTO.toost, caption: 'Opgestoken met haaraccessoire' },
  { cat: 'visagie', ratio: '3x4', p: PHOTO.sluier, caption: 'Soft glam met sluier' },
  { cat: 'kapsel', ratio: '4x5', p: PHOTO.halfLos, caption: 'Half-los met lange golven' },
  { cat: 'complete', ratio: '3x2', p: PHOTO.omhelzing, caption: 'Romantische opsteek met parels' },
  { cat: 'kapsel', ratio: '4x5', p: PHOTO.golven, caption: 'Hollywood-golven op donker haar' },
  { cat: 'complete', ratio: '2x3', p: PHOTO.kapel, caption: 'In het licht van de kapel' },
  { cat: 'kapsel', ratio: '4x5', p: PHOTO.lageKnot, caption: 'Losse lage knot' },
  { cat: 'visagie', ratio: '3x4', p: PHOTO.oogschaduw, caption: 'Soft glam: oogschaduw' },
  { cat: 'complete', ratio: '4x5', p: PHOTO.tafel, caption: 'Zachte opsteek met parels' },
  { cat: 'kapsel', ratio: '3x4', p: PHOTO.blondeKrullen, caption: 'Half-los met volle krullen' },
  { cat: 'complete', ratio: '2x3', p: PHOTO.gevlochten, caption: 'Gevlochten opsteek met bloemen' },
  { cat: 'kapsel', ratio: '3x4', p: PHOTO.lageStaart, caption: 'Strakke lage staart' },
  { cat: 'complete', ratio: '2x3', p: PHOTO.kapelOmhelzing, caption: 'Opgestoken bruidskapsel' },
  { cat: 'visagie', ratio: '3x4', p: PHOTO.wenkbrauwen, caption: 'Wenkbrauwen bijwerken' },
];
const filters = [['all', 'Alle'], ['kapsel', 'Bruidskapsel'], ['visagie', 'Bruidsvisagie'], ['complete', 'Complete look']]; // Destination / Gala & gasten chips return once there are real photos
---
<Base title="Portfolio bruidskapsels & bruidsmake-up | Lado Bridal"
  description="Bekijk bruidskapsels en bruidsmake-up van Lado Bridal: los, half-los en opgestoken, naturel tot glam, in Friesland, Noord-Nederland en het buitenland."
  ogTitle="Portfolio · Lado Bridal" ogDescription="Bruidskapsels en bruidsmake-up van Friese landgoederen tot Italiaanse bruiloften."
  breadcrumbs={crumbs}>
  <PageHero crumbs={crumbs} eyebrow="Portfolio" h1="Portfolio bruidskapsels &amp; bruidsmake-up" cta={false}
    lead="Echte bruiden, echte trouwdagen. Filter op wat je zoekt en klik op een foto voor een grotere weergave." />
  <section class="section--tight" style="padding-top:0">
    <div class="container">
      <div class="filter-chips" role="group" aria-label="Filter portfolio">
        {filters.map(([v, l], i) => <button type="button" class="chip" data-filter={v} aria-pressed={i === 0 ? 'true' : 'false'}>{l}</button>)}
      </div>
      <div class="masonry" data-masonry>
        {items.map((it, i) => (
          <figure class="masonry__item" data-cat={it.cat} data-caption={it.caption} style={`margin-left:0;margin-right:0;view-transition-name:pf-${i}`}>
            <button type="button" class="masonry__btn" aria-label={`${it.caption}, vergroten`}>
              <Img ratio={it.ratio as any} shot={it.caption} src={it.p.src} alt={it.p.alt} reveal={false} sizes="(min-width: 900px) 30vw, 50vw" />
              <span class="masonry__cap">{it.caption}</span>
            </button>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <div class="lightbox" data-lightbox role="dialog" aria-modal="true" aria-label="Foto vergroot" aria-hidden="true">
    <div class="lightbox__top"><span class="small" data-lb-count></span><button type="button" data-lb-close aria-label="Sluiten"><Icon name="close" size={26} /></button></div>
    <div class="lightbox__stage" data-lb-stage></div>
    <div class="lightbox__bottom">
      <button type="button" data-lb-prev aria-label="Vorige foto"><Icon name="arrow-left" size={26} /></button>
      <p class="small" data-lb-cap style="flex:1;text-align:center"></p>
      <button type="button" data-lb-next aria-label="Volgende foto"><Icon name="arrow-right" size={26} /></button>
      <button type="button" class="btn btn--light btn--sm" data-open-form style="flex-basis:100%">Deze look voor jouw dag? Check je datum</button>
    </div>
  </div>

  <section class="section section--linen">
    <div class="container">
      <div class="cluster" style="justify-content:space-between;margin-bottom:2rem">
        <div><p class="eyebrow">Instagram</p><h2 class="mt-1">Volg <em>@lado.bridal</em></h2></div>
        <a class="btn btn--outline" href={SITE.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={18} /> Naar Instagram</a>
      </div>
      <div class="insta-grid">
        {[1, 2, 3, 4, 5, 6].map((n) => <a href={SITE.instagram} target="_blank" rel="noopener" aria-label={`Instagram-post ${n} van @lado.bridal`}><Img ratio="1x1" shot={`Instagram ${n}`} /></a>)}
      </div>
      <p class="small muted mt-2">Statische afbeeldingen (geen zware embed), handmatig bij te werken in <code>src/pages/portfolio.astro</code>.</p>
    </div>
  </section>
  <Cta />
</Base>
