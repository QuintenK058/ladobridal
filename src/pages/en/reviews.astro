---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Reviews from '../../components/Reviews.astro';
import Cta from '../../components/Cta.astro';
const crumbs = [{ name: 'Home', href: '/en' }, { name: 'Reviews', href: '/en/reviews' }];
---
<Base title="Hair extension reviews | By Lado Leeuwarden" description="Real reviews about hair extensions at By Lado in Leeuwarden, shown in their original language." breadcrumbs={crumbs}>
  <PageHero lang="en" crumbs={crumbs} eyebrow="Reviews" h1="Reviews of hair extensions at <em>By Lado</em>" cta={false} lead="Real reviews only, shown in their original language." />
  <section class="section--tight" style="padding-top:0"><div class="container"><Reviews variant="carousel" lang="en" /></div></section>
  <Cta lang="en" />
</Base>
