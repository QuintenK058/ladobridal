---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Img from '../../components/Img.astro';
import Cta from '../../components/Cta.astro';
const crumbs = [{ name: 'Home', href: '/en' }, { name: 'Portfolio', href: '/en/portfolio' }];
const shots = ['bridal updo', 'natural make-up', 'half-up with veil', 'wedding in Italy', 'bridesmaids', 'barn wedding look'];
---
<Base title="Portfolio: bridal hair & make-up | Lado Bridal" description="Bridal hairstyles and make-up by Lado Bridal: down, half-up and updos, natural to glam, in the Netherlands and abroad." breadcrumbs={crumbs}>
  <PageHero lang="en" crumbs={crumbs} eyebrow="Portfolio" h1="Portfolio: bridal hair &amp; make-up" cta={false} lead="Real brides, real wedding days. The full filterable portfolio is on the Dutch page." secondary={{ href: '/portfolio', label: 'Full portfolio (Dutch)' }} />
  <section class="section--tight" style="padding-top:0"><div class="container"><div class="look-grid look-grid--3">{shots.map((s, i) => <Img ratio={i % 2 ? '3x4' : '4x5'} shot={s} />)}</div></div></section>
  <Cta lang="en" />
</Base>
